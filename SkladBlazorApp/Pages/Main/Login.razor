@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using SkladBlazorApp.Client.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Вход в систему</PageTitle>

<h3>Вход в систему</h3>

<EditForm Model="model" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Логин</label>
        <InputText @bind-Value="model.Login" class="form-control" />
        <ValidationMessage For="@(() => model.Login)" />
    </div>

    <div class="form-group">
        <label>Пароль</label>
        <InputText type="password" @bind-Value="model.Password" class="form-control" />
        <ValidationMessage For="@(() => model.Password)" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Войти</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    private LoginDto model = new();
    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", model);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>()
                             ?? new LoginResponse();


                if (!string.IsNullOrEmpty(result.token))    
{
                    // 1️⃣ Сохраняем токен
                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.token);    

                    // 2️⃣ Уведомляем провайдер, чтобы CascadingAuthenticationState обновился
                    ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserAuthentication(result.token);

                    // 3️⃣ Редирект на страницу товаров
                    Navigation.NavigateTo("/products"); // <-- без true, чтобы не было hard reload
                }
                else
                {
                    errorMessage = "Токен не получен от сервера";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync() ?? "Неизвестная ошибка";
                if (errorContent.Contains("error"))
                {
                    var jsonDoc = System.Text.Json.JsonDocument.Parse(errorContent);
                    errorMessage = jsonDoc.RootElement.GetProperty("error").GetString() ?? "Неверный логин или пароль";
                }
                else
                {
                    errorMessage = "Неверный логин или пароль";
                }
            }
        }
        catch
        {
            errorMessage = "Ошибка подключения к серверу";
        }
    }

    public class LoginResponse
    {
        public string token { get; set; } = string.Empty;
    }
}
