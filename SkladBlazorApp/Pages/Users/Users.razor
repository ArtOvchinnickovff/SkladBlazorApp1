@page "/users"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using SkladBlazorApp.Shared.Models
@using SkladBlazorApp.Shared.ModelsDTO
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized Context="authContext">
        <h3 class="mb-4">👤 Управление пользователями </h3>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @messageClass">@message</div>
        }

        <!-- Кнопка создания -->
        <button class="btn btn-primary mb-3" @onclick="StartCreate">
            + Создать нового пользователя
        </button>

        <!-- ФОРМА СОЗДАНИЯ / РЕДАКТИРОВАНИЯ -->
        @if (showForm)
        {
            <div class="card p-4 mb-4 shadow">
                <h5>@(isEditing ? "Редактирование пользователя" : "Новый пользователь")</h5>

                <EditForm Model="userDto" OnValidSubmit="SaveUser">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">
                        <div class="col-md-4">
                            <label>Логин</label>
                            <InputText class="form-control" @bind-Value="userDto.Login" />
                        </div>
                        <div class="col-md-4">
                            <label>Пароль @(isEditing ? "(оставьте пустым, если не менять)" : "")</label>
                            <InputText type="password" class="form-control" @bind-Value="userDto.Password" />
                        </div>
                        <div class="col-md-4">
                            <label>Роль</label>
                            <InputSelect class="form-select" @bind-Value="userDto.Role">
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-success me-2">
                            @(isEditing ? "Сохранить изменения" : "Создать пользователя")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelForm">Отмена</button>
                    </div>
                </EditForm>
            </div>
        }

        <!-- ТАБЛИЦА ПОЛЬЗОВАТЕЛЕЙ -->
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Логин</th>
                    <th>Роль</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.Login</td>
                        <td>
                            <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-primary")">
                                @user.Role
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => StartEdit(user)">
                                ✏️ Редактировать
                            </button>
                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => DeleteUser(user.Id)">
                                🗑 Удалить
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Authorized>
    <NotAuthorized>
        <p class="text-danger fs-4">Доступ запрещён. Только Админ может управлять пользователями.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<User> users = new();
    private CreateUsersDto userDto = new();
    private bool showForm = false;
    private bool isEditing = false;
    private int? editingId;
    private string message = "";
    private string messageClass = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await Http.GetFromJsonAsync<List<User>>("api/users") ?? new();
    }

    private void StartCreate()
    {
        userDto = new CreateUsersDto { Role = "Manager" };
        showForm = true;
        isEditing = false;
        message = "";
    }

    private void StartEdit(User user)
    {
        userDto = new CreateUsersDto
        {
            Login = user.Login,
            Role = user.Role,
            Password = ""
        };
        editingId = user.Id;
        showForm = true;
        isEditing = true;
        message = "";
    }

    private void CancelForm()
    {
        showForm = false;
        isEditing = false;
    }

    private async Task SaveUser()
    {
        if (isEditing && editingId.HasValue)
        {
            var response = await Http.PutAsJsonAsync($"api/users/{editingId}", userDto);
            message = response.IsSuccessStatusCode ? "Пользователь успешно обновлён!" : "Ошибка при обновлении";
            messageClass = response.IsSuccessStatusCode ? "alert-success" : "alert-danger";
        }
        else
        {
            var response = await Http.PostAsJsonAsync("api/users", userDto);
            message = response.IsSuccessStatusCode ? "Пользователь успешно создан!" : "Ошибка создания (логин уже занят)";
            messageClass = response.IsSuccessStatusCode ? "alert-success" : "alert-danger";
        }

        showForm = false;
        isEditing = false;
        await LoadUsers();
    }

    private async Task DeleteUser(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Удалить этого пользователя навсегда?");
        if (!confirmed) return;

        var response = await Http.DeleteAsync($"api/users/{id}");
        message = response.IsSuccessStatusCode ? "Пользователь удалён" : "Ошибка удаления";
        messageClass = response.IsSuccessStatusCode ? "alert-success" : "alert-danger";

        await LoadUsers();
    }
}