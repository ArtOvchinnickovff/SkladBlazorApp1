@page "/categories"
@attribute [Authorize(Roles = "Admin,Manager")]

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http

<AuthorizeView Roles="Admin,Manager" Context="authContext">
    <Authorized Context="authContext">

        <h3 class="mb-3">Категории</h3>

        <button class="btn btn-success mb-3" @onclick="ShowCreateForm">
            Добавить категорию
        </button>

        @if (showForm)
        {
            <div class="card p-3 mb-3">

                <EditForm Model="currentCategory" OnValidSubmit="SaveCategory">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col">
                            <InputText class="form-control"
                                       @bind-Value="currentCategory.Name"
                                       placeholder="Название категории" />
                        </div>
                        <div class="col">
                            <InputText class="form-control"
                                       @bind-Value="currentCategory.Description"
                                       placeholder="Описание" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        Сохранить
                    </button>
                    <button type="button" class="btn btn-secondary mt-3 ms-2" @onclick="CancelEdit">
                        Отмена
                    </button>
                </EditForm>

            </div>
        }

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Описание</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in categories)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.Description</td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => EditCategory(category)">
                                Ред.
                            </button>

                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button class="btn btn-sm btn-danger ms-2" @onclick="() => DeleteCategory(category.Id)">
                                        Удалить
                                    </button>
                                </Authorized>
                            </AuthorizeView>

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </Authorized>

    <NotAuthorized>
        <p class="text-danger">Доступ запрещён</p>
    </NotAuthorized>
</AuthorizeView>

@code {

    private List<CategoryDto> categories = new();
    private CategoryDto currentCategory = new();
    private bool showForm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories") ?? new();
    }

    private void ShowCreateForm()
    {
        currentCategory = new CategoryDto();
        showForm = true;
    }

    private void EditCategory(CategoryDto category)
    {
        currentCategory = new CategoryDto
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description
        };

        showForm = true;
    }

    private async Task SaveCategory()
    {
        if (currentCategory.Id == 0)
            await Http.PostAsJsonAsync("api/categories", currentCategory);
        else
            await Http.PutAsJsonAsync($"api/categories/{currentCategory.Id}", currentCategory);

        showForm = false;
        await LoadCategories();
    }

    private async Task DeleteCategory(int id)
    {
        await Http.DeleteAsync($"api/categories/{id}");
        await LoadCategories();
    }

    private void CancelEdit()
    {
        showForm = false;
    }

    public class CategoryDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
    }

}