@using Microsoft.AspNetCore.Components.Authorization
@using SkladBlazorApp.Client.Services

@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SkladBlazorApp</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="flex-column">

        <AuthorizeView Context="auth">
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="oi oi-home" aria-hidden="true"></span> Главная
                    </NavLink>
                </div>

               

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="products">
                        Товары
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="categories">Категории</NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="operations">
                        Складские операции
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">
                        <span class="oi oi-document" aria-hidden="true"></span> Отчеты
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="admin">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="users">
                                Пользователи
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <button class="btn btn-link nav-link text-danger" @onclick="Logout">
                        Выйти
                    </button>
                </div>

            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        Войти
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");

        if (AuthStateProvider is CustomAuthenticationStateProvider provider)
        {
            provider.NotifyUserLogout();
        }

        Navigation.NavigateTo("/login", true);
    }
}
